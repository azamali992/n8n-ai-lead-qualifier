      "id": "3e0e5dae-da8c-5ddc-8d9f-b792b140f6a1",
      "name": "Qualify with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        180
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "geminiHeaderAuth",
          "name": "Gemini API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turn Gemini's JSON into a scored lead. The model scores; Config's thresholds decide the route,\n// so sales can tune \"how hot is hot\" without touching the prompt.\nconst cfg = $('Config').item.json;\nconst lead = $('Normalize lead').item.json;\nconst text = $json.candidates?.[0]?.content?.parts?.[0]?.text;\nif (!text) throw new Error('Gemini returned no content');\n\nlet ai;\ntry { ai = JSON.parse(text); } catch (e) { throw new Error('Gemini returned invalid JSON: ' + text.slice(0, 200)); }\n\nconst score = Math.max(0, Math.min(100, Math.round(Number(ai.score) || 0)));\nlet category = 'cold';\nif (ai.is_spam === true) category = 'spam';\nelse if (score >= cfg.hotScore) category = 'hot';\nelse if (score >= cfg.warmScore) category = 'warm';\n\nreturn {\n  ...lead,\n  category,\n  score,\n  intent: ai.intent ?? '',\n  budget: ai.budget ?? '',\n  timeline: ai.timeline ?? '',\n  summary: ai.summary ?? '',\n  reasons: Array.isArray(ai.reasons) ? ai.reasons.join('; ') : '',\n  replyDraft: ai.reply_draft ?? '',\n  qualifiedBy: 'ai',\n};"
      },
      "id": "429cedbf-0884-543c-87ff-11d70527b05d",
      "name": "Score and route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The AI call failed (outage, quota, bad key). Never drop a lead: log it for a human.\nconst lead = $('Normalize lead').item.json;\nreturn {\n  ...lead,\n  category: 'review',\n  score: null,\n  intent: '', budget: '', timeline: '',\n  summary: 'AI qualification failed, needs manual review',\n  reasons: String($json.error?.message ?? $json.error ?? 'unknown error').slice(0, 300),\n  replyDraft: '',\n  qualifiedBy: 'fallback',\n};"
      },
      "id": "f66c1c9a-1687-50f7-9f26-44c20dddcb65",
      "name": "Fallback: manual review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        420
      ]
    },
